<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <!-- Filter for neon glows -->
    <filter id="glow-cyan" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="8" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <filter id="glow-soft" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="12" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>

    <!-- Glass Orb Background Radial Gradient -->
    <radialGradient id="orbBg" cx="50%" cy="45%" r="50%">
      <stop offset="0%" stop-color="#0e2348" />
      <stop offset="60%" stop-color="#06122b" />
      <stop offset="90%" stop-color="#020817" />
      <stop offset="100%" stop-color="#00030a" />
    </radialGradient>

    <!-- Outer Neon Ring Gradient -->
    <linearGradient id="neonRingGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00f0ff" />
      <stop offset="50%" stop-color="#0072ff" />
      <stop offset="100%" stop-color="#00d2ff" />
    </linearGradient>

    <!-- Glass Rim Highlight Gradient -->
    <linearGradient id="glassRimGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#7dd3fc" stop-opacity="0.9" />
      <stop offset="30%" stop-color="#0284c7" stop-opacity="0.4" />
      <stop offset="70%" stop-color="#0369a1" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.8" />
    </linearGradient>

    <!-- Letter "i" Stem Gradient -->
    <linearGradient id="iStemGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#0284c7" />
    </linearGradient>

    <!-- Letter "i" Dot Gold/Orange Sphere -->
    <radialGradient id="iDotGrad" cx="35%" cy="35%" r="65%">
      <stop offset="0%" stop-color="#ffea79" />
      <stop offset="40%" stop-color="#ff9100" />
      <stop offset="100%" stop-color="#d94600" />
    </radialGradient>

    <!-- Ribbon M Left Leg (Orange to Magenta) -->
    <linearGradient id="mLeftGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ff7b00" />
      <stop offset="40%" stop-color="#ff006e" />
      <stop offset="100%" stop-color="#d90082" />
    </linearGradient>

    <!-- Ribbon M Middle V (Magenta to Purple) -->
    <linearGradient id="mMidGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#d90082" />
      <stop offset="60%" stop-color="#8a2be2" />
      <stop offset="100%" stop-color="#4a00e0" />
    </linearGradient>

    <!-- Ribbon M Right Leg (Purple to Electric Blue) -->
    <linearGradient id="mRightGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#8a2be2" />
      <stop offset="60%" stop-color="#0066ff" />
      <stop offset="100%" stop-color="#00d2ff" />
    </linearGradient>

    <!-- Graduation Cap Top Gradient -->
    <linearGradient id="capTopGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="50%" stop-color="#1d4ed8" />
      <stop offset="100%" stop-color="#1e1b4b" />
    </linearGradient>

    <!-- Tassel Gold Gradient -->
    <linearGradient id="tasselGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="50%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#b45309" />
    </linearGradient>

    <!-- Glass Specular Highlight Top -->
    <linearGradient id="specularTop" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.6" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </linearGradient>
  </defs>

  <!-- Background Base -->
  <rect width="512" height="512" fill="#000000" rx="999" />

  <!-- Glass Orb Outer Glow Aura -->
  <circle cx="256" cy="256" r="216" fill="none" stroke="#00d2ff" stroke-width="4" opacity="0.3" filter="url(#glow-soft)" />

  <!-- Glass Orb Body -->
  <circle cx="256" cy="256" r="210" fill="url(#orbBg)" />

  <!-- Glass Orb Inner Edge Ring -->
  <circle cx="256" cy="256" r="210" fill="none" stroke="url(#glassRimGrad)" stroke-width="3.5" />
  <circle cx="256" cy="256" r="206" fill="none" stroke="url(#neonRingGrad)" stroke-width="1.5" opacity="0.8" />

  <!-- Top Glass Specular Reflection Crescent -->
  <path d="M 120 110 A 180 180 0 0 1 392 110 A 195 195 0 0 0 120 110 Z" fill="url(#specularTop)" opacity="0.3" />

  <!-- Bottom Glass Subtle Reflection Curve -->
  <path d="M 150 420 A 180 180 0 0 0 362 420 A 190 190 0 0 1 150 420 Z" fill="#38bdf8" opacity="0.25" />

  <!-- LOGO EMBLEM GROUP -->
  <g transform="translate(0, 8)">

    <!-- LETTER "i" -->
    <!-- Dot (Orange Gold Sphere) -->
    <circle cx="162" cy="192" r="19" fill="url(#iDotGrad)" />
    <circle cx="156" cy="186" r="6" fill="#ffffff" opacity="0.6" />

    <!-- Stem -->
    <rect x="144" y="222" width="36" height="152" rx="18" fill="url(#iStemGrad)" />
    <!-- Stem Highlight -->
    <rect x="148" y="226" width="10" height="140" rx="5" fill="#ffffff" opacity="0.2" />

    <!-- LETTER "M" (3D Ribbon Flow Style) -->
    <!-- M Left Arch (Orange to Pink) -->
    <path d="M 200 374 L 200 236 C 200 215 220 210 238 230 L 268 275 C 274 284 282 284 288 275 L 318 230 C 336 210 356 215 356 236 L 356 374"
          fill="none" stroke="url(#mLeftGrad)" stroke-width="36" stroke-linecap="round" stroke-linejoin="round" />

    <!-- M Center V Overlap Shadow & Gradient Layer -->
    <path d="M 232 232 L 272 290 C 276 296 280 296 284 290 L 324 232"
          fill="none" stroke="url(#mMidGrad)" stroke-width="32" stroke-linecap="round" stroke-linejoin="round" />

    <!-- M Right Leg Stroke (Purple to Cyan) -->
    <path d="M 284 282 L 320 230 C 334 212 352 218 352 236 L 352 374"
          fill="none" stroke="url(#mRightGrad)" stroke-width="34" stroke-linecap="round" stroke-linejoin="round" />

    <!-- Bright Highlights on M Fold Arches -->
    <path d="M 206 366 L 206 240 C 206 226 218 222 230 234"
          fill="none" stroke="#ffffff" stroke-width="4" stroke-linecap="round" opacity="0.35" />
    <path d="M 346 240 L 346 366"
          fill="none" stroke="#ffffff" stroke-width="4" stroke-linecap="round" opacity="0.25" />

    <!-- GRADUATION CAP (MORTARBOARD) -->
    <g transform="translate(270, 158)">

      <!-- Cap Skullcap Base -->
      <path d="M -50 16 L 0 28 L 50 16 L 50 26 C 50 36 28 44 0 44 C -28 44 -50 36 -50 26 Z"
            fill="#1e3a8a" />
      <path d="M -50 26 C -50 36 -28 44 0 44 C 28 44 50 36 50 26"
            fill="none" stroke="#3b82f6" stroke-width="2" opacity="0.6" />

      <!-- Cap Diamond Top Plate -->
      <polygon points="0,-28 85,4 0,36 -85,4" fill="url(#capTopGrad)" />
      <polygon points="0,-28 85,4 0,36 -85,4" fill="none" stroke="#60a5fa" stroke-width="3" />
      <polygon points="0,-25 78,4 0,32 -78,4" fill="none" stroke="#ffffff" stroke-width="1" opacity="0.3" />

      <!-- Code Symbol "</>" on Cap Top -->
      <text x="0" y="8" font-family="monospace, sans-serif" font-weight="900" font-size="20" fill="#ffffff" text-anchor="middle" dominant-baseline="middle" letter-spacing="-1">
        &lt;/&gt;
      </text>

      <!-- Center Button on Cap -->
      <circle cx="0" cy="4" r="5" fill="#f59e0b" stroke="#ffffff" stroke-width="1" />

      <!-- Golden Tassel Strap & Fringe -->
      <path d="M 0 4 C 30 6 62 18 68 32" fill="none" stroke="url(#tasselGrad)" stroke-width="3.5" stroke-linecap="round" />

      <!-- Tassel Ring/Band -->
      <rect x="64" y="32" width="8" height="4" rx="1" fill="#fef08a" />

      <!-- Tassel Fringe/Pendant -->
      <polygon points="64,36 72,36 75,58 61,58" fill="url(#tasselGrad)" />
      <line x1="64" y1="36" x2="62" y2="58" stroke="#fef08a" stroke-width="1" />
      <line x1="68" y1="36" x2="68" y2="58" stroke="#f59e0b" stroke-width="1" />
      <line x1="72" y1="36" x2="74" y2="58" stroke="#fef08a" stroke-width="1" />
    </g>

  </g>
</svg>
